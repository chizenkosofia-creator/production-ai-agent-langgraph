[flake8]
max-line-length = 100
# E203/W503 conflict with black's formatting.
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    .venv,
    .cache,
    .npm,
    .npm-global,
    .local,
    .config,
    .claude
per-file-ignores =
    # conftest sets environment variables before importing the app (E402 by design)
    tests/conftest.py: E402
    # fixtures re-imported from another test module look "redefined" to flake8
    tests/test_guardrails_observability.py: F401, F811

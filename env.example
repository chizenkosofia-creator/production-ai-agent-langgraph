# Copy to .env and fill in real values. Never commit .env.

# --- LLM (any OpenAI-compatible endpoint; Groq by default) ---
LLM_API_KEY=gsk-replace-me
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
LOG_LEVEL=INFO

# --- Database (used by docker-compose for the container AND to build DATABASE_URL) ---
POSTGRES_USER=agent
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=agent_db
# Only needed when running the API outside docker-compose.
# DATABASE_URL=postgresql://agent:change-me-in-production@localhost:5432/agent_db

# --- RAG ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
RAG_COLLECTION=company_kb

# --- Background jobs (Celery + Redis; compose points REDIS_URL at the redis service) ---
# REDIS_URL=redis://localhost:6379/0
NOTIFICATION_EMAIL_TO=oncall@example.com
NOTIFICATION_SLACK_CHANNEL=#support-urgent
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_SECONDS=30
# Only paths under this directory can be ingested by the Celery KB job.
KB_DOCS_DIR=kb_docs
# Run tasks inline instead of via Redis (local debugging only).
# CELERY_TASK_ALWAYS_EAGER=false

# --- Observability: LangSmith tracing (off unless enabled) ---
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=enterprise-support-agent
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# --- Frontend (JSON list of allowed browser origins) ---
# CORS_ALLOW_ORIGINS=["http://localhost:3000"]
